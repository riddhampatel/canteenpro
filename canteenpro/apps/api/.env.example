# ---------- Database (Neon) ----------
# Pooled connection string (host contains "-pooler") — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/canteenpro?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct connection string (no "-pooler") — used by prisma migrate
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/canteenpro?sslmode=require"

# ---------- Server ----------
PORT=4000
NODE_ENV=development
JWT_SECRET="change-me-to-a-long-random-string"
# 32-byte key, base64 — encrypts secrets (Razorpay/SMTP/OneSignal) stored in DB
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""
# Comma separated list of allowed browser origins
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:5174"

# Public URLs (used in emails and redirects)
WEBSITE_URL="http://localhost:3000"
CONSOLE_URL="http://localhost:5173"
SUPERADMIN_URL="http://localhost:5174"

# ---------- Jobs ----------
CRON_ENABLED=true
CRON_TIMEZONE="Asia/Kolkata"

# ---------- Optional fallbacks (Super Admin → Settings overrides these) ----------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
ONESIGNAL_APP_ID=""
ONESIGNAL_REST_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CanteenPro <no-reply@canteenpro.in>"

# Allows "simulate payment" when Razorpay keys are missing (never enable in production)
PAYMENTS_TEST_MODE=true

# Seed super admin
SEED_ADMIN_EMAIL="admin@canteenpro.in"
SEED_ADMIN_PASSWORD="Admin@123"
